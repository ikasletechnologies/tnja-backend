generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PENDING
  REJECTED
  APPROVED
  REPLAY
  CLOSED
  NOT_REQUIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  taluks    Taluk[]
  students  Student[]
  coaches   CoachReferee[]
  clubs     Club[]
  members   Member[]
  events    Event[]
}

model Taluk {
  id         String         @id @default(uuid())
  name       String
  pincode    String
  districtId String
  district   District       @relation(fields: [districtId], references: [id])
  clubs      Club[]
  students   Student[]
  coaches    CoachReferee[]
  members    Member[]
}

model Club {
  id               String         @id @default(uuid())
  tempId           String?        @unique
  name             String
  districtId       String?
  district         District?      @relation(fields: [districtId], references: [id])
  talukId          String?
  taluk            Taluk?         @relation(fields: [talukId], references: [id])
  pincode          String
  mobileNumber     String
  email            String         @unique
  address1         String
  address2         String?
  president        String
  secretary        String
  coach            String
  noOfStudents     Int            @default(0)
  maleStudents     Int            @default(0)
  femaleStudents   Int            @default(0)
  age6to11Male     Int            @default(0)
  age6to11Female   Int            @default(0)
  age12to18Male    Int            @default(0)
  age12to18Female  Int            @default(0)
  age16AboveMale   Int            @default(0)
  age16AboveFemale Int            @default(0)
  password         String         @default("")
  permanentId      String?        @unique
  status           Status         @default(PENDING)
  rejectionRemark  String?
  approvedBy       String?
  approvedAt       DateTime?
  mustChangePassword Boolean      @default(false)
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  isPaid           Boolean        @default(false)
  validUntil       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  students         Student[]
  coaches          CoachReferee[]
  tournaments      Tournament[]
}

model Student {
  id                    String        @id @default(uuid())
  tempId                String        @unique
  permanentId           String?       @unique
  districtId            String
  district              District      @relation(fields: [districtId], references: [id])
  talukId               String
  taluk                 Taluk         @relation(fields: [talukId], references: [id])
  pincode               String
  fullName              String
  profilePhoto          String?
  gender                Gender
  dob                   DateTime
  age                   Int
  bloodGroup            String
  mobileNumber          String        @unique
  alternateMobileNumber String?
  email                 String        @unique
  aadhaarNumber         String        @unique
  aadhaarProof          String?
  address               String
  city                  String
  state                 String
  addressPincode        String
  nationality           String
  annualIncome          Float
  incomeProof           String?
  isBPL                 Boolean       @default(false)
  bplProof              String?
  clubId                String?
  club                  Club?         @relation(fields: [clubId], references: [id])
  schoolName            String
  grade                 String
  areaOfInterest        String
  areaOfStudy           String
  preferLocation        String
  password              String
  status                Status        @default(PENDING)
  rejectionRemark       String?
  approvedBy            String?
  approvedAt            DateTime?
  mustChangePassword    Boolean       @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  isPaid                Boolean       @default(false)
  validUntil            DateTime?
  wins                  Int           @default(0)
  losses                Int           @default(0)
  draws                 Int           @default(0)
  coachId               String?
  coach                 CoachReferee? @relation("CoachStudents", fields: [coachId], references: [id])
  tournamentRegs        TournamentRegistration[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model CoachReferee {
  id                    String   @id @default(uuid())
  tempId                String   @unique
  permanentId           String?  @unique
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  talukId               String
  taluk                 Taluk    @relation(fields: [talukId], references: [id])
  pincode               String
  fullName              String
  fatherName            String
  profilePhoto          String?
  gender                Gender
  dob                   DateTime
  age                   Int
  bloodGroup            String
  mobileNumber          String   @unique
  alternateMobileNumber String?
  email                 String   @unique
  aadhaarNumber         String   @unique
  historyInJudo         String
  historyInOtherMartial String
  presentGradeInJudo    String
  coachName             String?
  refereeName           String?
  deptName              String
  contactPersonDept     String
  addressDept           String
  clubId                String?
  club                  Club?    @relation(fields: [clubId], references: [id])
  students              Student[] @relation("CoachStudents")
  password              String
  status                Status   @default(PENDING)
  rejectionRemark       String?
  approvedBy            String?
  approvedAt            DateTime?
  mustChangePassword    Boolean  @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  isPaid                Boolean  @default(false)
  validUntil            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum MemberRole {
  MEMBER
  DISTRICT_PRESIDENT
  DISTRICT_SECRETARY
  ZONE_PRESIDENT
  ZONE_SECRETARY
  STATE_PRESIDENT
  STATE_SECRETARY
  CEO
}

model Member {
  id                    String   @id @default(uuid())
  tempId                String   @unique
  permanentId           String?  @unique
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  talukId               String
  taluk                 Taluk    @relation(fields: [talukId], references: [id])
  pincode               String
  fullName              String
  fatherName            String
  profilePhoto          String?
  gender                Gender
  dob                   DateTime
  bloodGroup            String
  mobileNumber          String   @unique
  alternateMobileNumber String?
  email                 String   @unique
  aadhaarNumber         String   @unique
  aadhaarFront          String?
  aadhaarBack           String?
  addressLine1          String
  addressLine2          String?
  city                  String
  addressPincode        String
  employmentType        String?  // Self / Govt / Private
  companyName           String?
  designation           String?
  workLocation          String?
  role                  MemberRole @default(MEMBER)
  status                Status   @default(PENDING)
  rejectionRemark       String?
  approvedBy            String?
  approvedAt            DateTime?
  mustChangePassword    Boolean  @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  isPaid                Boolean  @default(false)
  validUntil            DateTime?
  password              String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tournaments           Tournament[]
}

enum EventLevel {
  DISTRICT
  ZONE
  STATE
  NATIONAL
}

enum EventParticipantType {
  ALL
  STUDENT
  COACH
  MEMBER
  CLUB
}

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  date            DateTime
  location        String
  level           EventLevel  @default(DISTRICT)
  participantType EventParticipantType @default(ALL)
  districtId      String?
  district        District?   @relation(fields: [districtId], references: [id])
  zoneId          String?
  createdBy       String      // ID of the person who created it
  status          Status      @default(PENDING)
  rejectionRemark String?
  approvedBy      String?
  approvedAt      DateTime?
  isPaid          Boolean     @default(false)
  entryFee        Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  registrations   EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  role      String   // STUDENT, COACH, MEMBER, CLUB
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model Tournament {
  id                 String                   @id @default(uuid())
  title              String
  date               DateTime                 // This acts as dateFrom
  dateTo             DateTime?
  location           String
  description        String
  entryFee           Float                    @default(0)
  totalSlots         Int                      @default(32)
  ageFrom            Int                      @default(0)
  ageTo              Int                      @default(100)
  gender             String                   @default("BOTH")
  allowBPL           Boolean                  @default(false)
  beltEligibility    String?
  level              EventLevel               @default(DISTRICT)
  
  districtApproval   Status                   @default(PENDING)
  stateApproval      Status                   @default(PENDING)
  superAdminApproval Status                   @default(PENDING)
  ceoApproval        Status                   @default(PENDING)
  
  status             Status                   @default(PENDING)
  rejectionRemark    String?
  
  clubId             String?
  club               Club?                    @relation(fields: [clubId], references: [id])
  officialId         String?
  official           Member?                  @relation(fields: [officialId], references: [id])
  registrations      TournamentRegistration[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model TournamentRegistration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  playerId     String
  player       Student    @relation(fields: [playerId], references: [id])
  status       Status     @default(PENDING)
  isPaid       Boolean    @default(false)
  paymentId    String?
  height       String?
  weight       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, playerId])
}

model GlobalSettings {
  id              String   @id @default("GLOBAL")
  playerFee       Float    @default(500)
  coachFee        Float    @default(1000)
  memberFee       Float    @default(1000)
  clubFee         Float    @default(1000)
  updatedAt       DateTime @updatedAt
}

model Grievance {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  userEmail   String
  role        String   // Student, Coach, or Referee
  subject     String
  description String
  status      Status   @default(PENDING)
  reply       String?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
